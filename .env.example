# Copiar a .env y ajustar. NO subir .env al repositorio.

# --- PostgreSQL ---
POSTGRES_USER=mundorepuestos
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=mundorepuestos
DB_PORT=5460  # puerto del host; 5432-5436 suelen estar ocupados por otros PostgreSQL

# --- Herramientas (profile "tools") ---
ADMINER_PORT=8080

# --- Aplicacion ---
# Modo de despliegue: edge (servidor en tienda) o cloud (nube)
MODE=edge
# Entorno: desarrollo | produccion (en produccion no se publican /docs ni openapi.json y datos-demo se bloquea)
ENV=desarrollo
# Identificador del nodo (UUID registrado en organizacion.nodos). En la nube puede omitirse (usa el nodo nube fijo
# 00000000-0000-7000-8000-000000000001); en cada edge debe ser el UUID de su nodo.
NODO_ID=
DATABASE_URL=postgresql+psycopg://mundorepuestos:cambiar_esta_clave@localhost:5460/mundorepuestos

# --- API / seguridad (secretos reales SOLO en .env, nunca aqui) ---
LOG_LEVEL=INFO
# Catalogo / inventario
MEDIA_DIR=media          # imagenes de productos (relativo a la raiz del repo)
IMAGEN_MAX_MB=5
AJUSTE_UMBRAL_VALOR=500000   # COP: un ajuste de inventario que lo supere exige autorizacion de supervisor
# Origenes permitidos por CORS, separados por coma (vacio = sin CORS)
CORS_ORIGINS=
# Minimo 32 caracteres. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Pimienta para el indice de PIN. NO cambiar una vez cargados PIN de empleados.
PIN_PEPPER=
ACCESS_TTL_MIN=15
REFRESH_TTL_DIAS=7
POS_SESION_TTL_MIN=600
MAX_INTENTOS_DISPOSITIVO=5
MAX_INTENTOS_EMPLEADO=5
BLOQUEO_MINUTOS=15
AUTORIZACION_TTL_SEG=120
